form ResponsavelLegalStep {
  nomeResponsavel: string {
    label = "Nome do Responsável";
    required = true;
  };
  emailResponsavel: string {
    label = "E-mail de Contato";
    required = true;
  };
}

form DadosCobrancaStep {
  nomeCobranca: string {
    label = "Nome na Fatura";
    default = ResponsavelLegalStep.nomeResponsavel;
  };
  emailFaturamento: string {
    label = "E-mail de Faturamento";
    default = ResponsavelLegalStep.emailResponsavel;
  };
}

api ClienteApi {
  POST "/api/v1/clientes" {
    consumes = CadastroClienteFlow;
    produces = uuid;
  }
}

// Formulário de duas páginas: a 1ª etapa é a origem da primeira transição.
flow CadastroClienteFlow {
  ResponsavelLegalStep -> DadosCobrancaStep;
  DadosCobrancaStep -> ClienteApi.POST;
}
