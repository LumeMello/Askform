// =====================================================================
// teste_completo.fad: mostra TODAS as funcionalidades do Askform de uma vez.
//
//   python main.py teste_completo.fad
//   python dist/app.py            (servidor em http://127.0.0.1:5000)
//   abra dist/cadastroflow.html   (formulário multi-página)
//   leia dist/API.md e dist/openapi.json (documentação gerada)
//
// Léxico ........ comentários // e /* */, strings com escape, números
//                 inteiros e decimais, todos os operadores (== != < <= > >=)
// Gramática ..... theme, form, api, flow, database; condições com
//                 and / or / not / ( ) / in / not in / is empty / is not empty
// Semântica ..... tipos, default (literal e Form.campo), validate, R4 (flow),
//                 R5 (consumes), R9 (chave da rota required), dominância
// Geradores ..... HTML multi-etapas, Flask + SQLite, schema.sql, API.md, openapi.json
// =====================================================================

/* Bloco 1: tema visual (vira CSS do HTML gerado) */
theme Completo {
  background = "#0f172a";
  card_background = "#1e293b";
  text_color = "#f8fafc";
  accent_color = "#38bdf8";
  font_family = "Segoe UI, sans-serif";
  border_radius = "12px";
}

// Bloco 2: formulários. Um por etapa do flow, e um independente (CupomForm).

form IdentificacaoStep {
  nome: string {
    label = "Nome completo";
    required = true;
  };
  tipo: string {
    label = "Tipo de cliente (PF ou PJ)";
    required = true;
  };
  idade: integer {
    label = "Idade";
    required = true;
  };
  idadeMinima: integer {
    label = "Idade mínima exigida";
    required = true;
  };
  renda: float {
    label = "Renda mensal (R$)";
  };
  nascimento: date {
    label = "Data de nascimento";
  };
  idIndicador: uuid {
    label = "Código de quem indicou";
  };
  aceitaTermos: boolean {
    label = "Aceito os termos";
    required = true;
  };
  tags: string[] {
    label = "Interesses";
  };
  cupom: string {
    label = "Cupom (opcional)";
  };

  validate nome {
    min = 3;
    max = 60;
    message = "O nome deve ter entre 3 e 60 caracteres.";
  }
  validate tipo {
    pattern = "^(PF|PJ)$";
    message = "Informe PF ou PJ.";
  }
  validate idade {
    min = 0;
    max = 130;
  }
  validate renda {
    min = 0.0;
  }
}

form PessoaFisicaStep {
  cpf: string {
    label = "CPF";
    required = true;
  };
  profissao: string {
    label = "Profissão";
    default = "Não informada";
  };
  validate cpf {
    pattern = "^[0-9]{11}$";
    message = "CPF com 11 dígitos, só números.";
  }
}

form ResponsavelMenorStep {
  nomeResponsavel: string {
    label = "Nome do responsável legal";
    required = true;
  };
}

form EmpresaStep {
  cnpj: string {
    label = "CNPJ";
    required = true;
  };
  porte: string {
    label = "Porte (MEI, ME, EPP, GRANDE)";
    required = true;
  };
  logotipo: file {
    label = "Logotipo da empresa";
  };
  validate cnpj {
    pattern = "^[0-9]{14}$";
    message = "CNPJ com 14 dígitos, só números.";
  }
}

form ContatoStep {
  email: string {
    label = "E-mail";
    required = true;
  };
  confirmaNome: string {
    label = "Confirme o nome (já preenchido)";
    default = IdentificacaoStep.nome;
  };
  validate email {
    pattern = "^[^@ ]+@[^@ ]+$";
    message = "E-mail inválido.";
  }
}

form CupomForm {
  codigo: string {
    label = "Código do cupom";
    required = true;
  };
  desconto: float {
    label = "Desconto (%)";
    default = 10.5;
  };
  ativo: boolean {
    label = "Ativo";
    default = true;
  };
  anexo: file {
    label = "Regulamento (PDF)";
  };
  validate desconto {
    min = 0;
    max = 100;
  }
}

// Bloco 3: APIs REST. Todos os verbos, chave de rota, headers e flow como `consumes`.

api ClienteApi {
  POST "/api/v1/clientes" {
    consumes = CadastroFlow;
    produces = uuid;
    headers {
      "X-Origem": "askform";
      "X-Versao": "1";
    };
  }
}

api CupomApi {
  POST "/api/v1/cupons" { consumes = CupomForm; produces = uuid; }
  GET "/api/v1/cupons" { consumes = CupomForm; produces = string; }
  GET "/api/v1/cupons/{codigo}" { consumes = CupomForm; produces = string; }
  PUT "/api/v1/cupons/{codigo}" { consumes = CupomForm; produces = boolean; }
  PATCH "/api/v1/cupons/{codigo}" { consumes = CupomForm; produces = boolean; }
  DELETE "/api/v1/cupons/{codigo}" { consumes = CupomForm; produces = boolean; }
}

// Bloco 4: banco de dados (o compilador gera dist/schema.sql)
database Dados {
  engine = "sqlite";
  path = "completo.db";
  schema = "auto";
}

// Bloco 5: flow multi-etapas. A 1ª transição cuja condição vale decide o caminho.
flow CadastroFlow {
  // comparação de string
  IdentificacaoStep -> EmpresaStep when tipo == "PJ";
  // and + comparação campo x campo (idade contra idadeMinima)
  IdentificacaoStep -> ResponsavelMenorStep when tipo == "PF" and idade < idadeMinima;
  // caminho padrão (sem when): obrigatório quando as outras têm when
  IdentificacaoStep -> PessoaFisicaStep;

  // in / not in e booleano de etapa anterior
  EmpresaStep -> ContatoStep when porte in ("MEI", "ME", "EPP");
  EmpresaStep -> ContatoStep when porte not in ("MEI", "ME", "EPP") and IdentificacaoStep.aceitaTermos;
  EmpresaStep -> ContatoStep;

  // not + parênteses + operadores != e >= sobre campo de etapa anterior
  ResponsavelMenorStep -> ContatoStep when not (IdentificacaoStep.idade < 0) and IdentificacaoStep.idade != 99;
  ResponsavelMenorStep -> ContatoStep;

  // or + is not empty / is empty + comparação com decimal
  PessoaFisicaStep -> ContatoStep when IdentificacaoStep.cupom is not empty or IdentificacaoStep.renda >= 5000.5;
  PessoaFisicaStep -> ContatoStep when IdentificacaoStep.cupom is empty;
  PessoaFisicaStep -> ContatoStep;

  // envio final para a API
  ContatoStep -> ClienteApi.POST;
}
